BASE=`basename $0`
FILE=$1
read	CODE_HEX	LOCATION_HEX
CODE_HEX=`echo $CODE_HEX | tr [a-f] [A-F]`
LOCATION_HEX=`echo $LOCATION_HEX | tr [a-f] [A-F]`

if [ -z "$FILE" ]
then
	echo "Usage: "$BASE" file"
	exit 1
fi

# print file block ID, blank file number, provided file code
printf "\x03"
printf "\0"
printf `echo $CODE_HEX | sed 's/^/\\\\x/g'`

# print an 8 byte filename
printf "%s\0\0\0\0\0\0\0\0" `basename "$FILE" | sed 's/^\([^\.]*\)\..*$/\1/g'` | dd bs=1 count=8 2>/dev/null | tr [a-z_] [A-Z\-]

# need a file dest word, output little-endian
LEFT_BYTE=`printf "%s" "$LOCATION_HEX" | sed 's/^\([0-9A-F][0-9A-F]\)[0-9A-F][0-9A-F]$/\1/g'`
RIGHT_BYTE=`printf "%s" "$LOCATION_HEX" | sed 's/^[0-9A-F][0-9A-F]\([0-9A-F][0-9A-F]\)$/\1/g'`
printf `echo $RIGHT_BYTE | sed 's/^/\\\\x/g'`
printf `echo $LEFT_BYTE | sed 's/^/\\\\x/g'`

# emit file size word, output little-endian
SIZE=`ls -l "$FILE" | awk '{ print $5 }'`
LEFT_BYTE=`printf "%.4X" "$SIZE" | sed 's/^\([0-9A-F][0-9A-F]\)[0-9A-F][0-9A-F]$/\1/g'`
RIGHT_BYTE=`printf "%.4X" "$SIZE" | sed 's/^[0-9A-F][0-9A-F]\([0-9A-F][0-9A-F]\)$/\1/g'`
printf `echo $RIGHT_BYTE | sed 's/^/\\\\x/g'`
printf `echo $LEFT_BYTE | sed 's/^/\\\\x/g'`

# emit file type byte based on dest word:
LOCATION=`echo "ibase=16;$LOCATION_HEX" | bc`
if [ $LOCATION -ge 0 ] && [ $LOCATION -lt 8192 ]
then
	printf "\x01"	# CHR
elif [ $LOCATION -ge 8192 ] && [ $LOCATION -lt 12288 ]
then
	printf "\x02"	# BG 
else
	printf "\x00"	# PRG
fi

printf "\x04"	# file blob block
cat $FILE
