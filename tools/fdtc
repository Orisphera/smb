BASE=`basename "$0"`
FILES=$*
FILE_COUNT=`expr $#`

if [ $FILE_COUNT = 0 ]
then
	echo "Usage: "$BASE" file [ files ... ]"
	exit 1
fi

read	LICENSEE TITLE TYPE VERSION SIDE NUMBER DISK_TYPE START_CUTOFF \
	REGION COLOR DISK_VER

SHOWA_FACTOR=25

YEAR=`date +%Y`
MONTH=`date +%m`
DAY=`date +%d`

YEAR=`expr $YEAR - $SHOWA_FACTOR`

YEAR="\x"`echo $YEAR | sed s/^[0-9][0-9]//g`
MONTH="\x"$MONTH
DAY="\x"$DAY
FDSDATE=$YEAR$MONTH$DAY

SIDE=`echo $SIDE | tr [ab] [AB] | tr [AB] [01]`

if [ "$REGION" = "J" ]
then
	REGION=49	# Japan
fi

if [ "$COLOR" = "Y" ]
then
	COLOR=0		# Yellow
fi	

printf "\x01"
printf "*NINTENDO-HVC*"
printf `echo $LICENSEE  | sed 's/^/\\\\x/g'`
printf "%s" $TITLE
printf `echo $TYPE      | sed 's/^/\\\\x/g'`
printf `echo $VERSION   | sed 's/^/\\\\x/g'`
printf `echo $SIDE      | sed 's/^/\\\\x/g'`
printf `echo $NUMBER    | sed 's/^/\\\\x/g'`
printf `echo $DISK_TYPE | sed 's/^/\\\\x/g'`
printf "\0"
printf `echo $START_CUTOFF | sed 's/^/\\\\x/g'`
printf "\xFF\xFF\xFF\xFF\xFF"
printf $FDSDATE
printf `echo $REGION | sed 's/^/\\\\x/g'`
printf "\x61\x00"
printf "\x00\x02"
printf "\x00\x00\x00\x00\x00"
printf $FDSDATE
printf "\xFF"
printf "\xFF"
printf "\xFF\xFF"
printf "\xFF"
printf "\0"
printf `echo $SIDE      | sed 's/^/\\\\x/g'`
printf `echo $COLOR      | sed 's/^/\\\\x/g'`
printf `echo $DISK_VER   | sed 's/^/\\\\x/g'`

printf "\x02"
printf `echo "obase=16;$FILE_COUNT" | bc | sed 's/^/\\\\x/g'`

J=0
for I in $FILES
do
	dd if=$I bs=1 count=1 2>/dev/null
	printf `echo "obase=16;$J" | bc | sed 's/^/\\\\x/g'`
	dd if=$I bs=1 skip=2 2>/dev/null
	J=`expr $J + 1`
done
