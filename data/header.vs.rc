#!/bin/rc

# magic number
awk 'BEGIN { printf "NES\032" }' </dev/null

# 32kb PRG (2 banks)
awk 'BEGIN { printf "%c", 2 }' </dev/null

# 16kb CHR (2 banks)
awk 'BEGIN { printf "%c", 2 }' </dev/null

# metadata - mapper 03 (CNROM), vertical mirroring
awk 'BEGIN { printf "%c%c", 49, 0 }' </dev/null

# padding
awk 'BEGIN { printf "%c%c%c%c%c%c%c%c", 0, 0, 0, 0, 0, 0, 0, 0 }' </dev/null
